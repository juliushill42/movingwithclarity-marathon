{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/catalog.json", "destination": "/public/catalog.json" },
    { "source": "/concepts.json", "destination": "/public/concepts.json" },
    { "source": "/recordings/:file", "destination": "/public/recordings/:file" }
  ]
}
